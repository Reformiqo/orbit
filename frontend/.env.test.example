# Copy this to .env.test and fill in real values. .env.test is gitignored.
# Used by playwright.config.ts / tests/global-setup.ts.

ORBIT_BASE_URL=http://localhost:6003

# Default test user is created by running:
#   bench --site v16.erpera.io execute 'frappe.get_attr("orbit.tests.seed.create_test_user")()'
# Password matches orbit/tests/seed.py ORBIT_TESTER_PASSWORD.
ORBIT_TEST_USER=orbit-tester@example.com
ORBIT_TEST_PASSWORD=orbit-test-5!Xq
